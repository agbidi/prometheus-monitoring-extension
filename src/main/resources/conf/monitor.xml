<monitor>
        <name>PrometheusMonitor</name>
        <type>managed</type>
        <enabled>true</enabled>
        <description>Prometheus Monitor</description>
        <monitor-configuration></monitor-configuration>
        <monitor-run-task>
                <execution-style>periodic</execution-style>
                <execution-frequency-in-seconds>60</execution-frequency-in-seconds>
                <name>Prometheus Monitor Run Task</name>
                <display-name>Prometheus Monitor Task</display-name>
                <description>Prometheus Monitor Task</description>
                <type>java</type>
                <execution-timeout-in-secs>60</execution-timeout-in-secs>
                <task-arguments>
                    <!-- conf file-->
                    <argument name="config-file" is-required="true" default-value="monitors/PrometheusMonitor/config.yml" />
                </task-arguments>
                <java-task>
                        <classpath>prometheus-monitor.jar</classpath>
                        <impl-class>com.appdynamics.extensions.prometheus.PrometheusMonitor</impl-class>
                </java-task>
        </monitor-run-task>
</monitor>
